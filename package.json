{
  "name": "bodam",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "build": "next build",
    "test:e2e": "next build && playwright test",
    "test:e2e:run": "playwright test",
    "test:e2e:production": "playwright test --project=production",
    "test:e2e:intercept": "playwright test --project=intercept-portrait --project=intercept-landscape",
    "test:e2e:real": "playwright test --project=real-portrait --project=real-landscape",
    "test:e2e:strict": "playwright test -c playwright.dev.config.ts",
    "preview:kiosk": "next build && node --import ./tests/fixtures/engine/ts-resolve-register.mjs tests/e2e/harness/preview.ts",
    "preview:kiosk:run": "node --import ./tests/fixtures/engine/ts-resolve-register.mjs tests/e2e/harness/preview.ts",
    "preview:bundle": "next build && node --import ./tests/fixtures/engine/ts-resolve-register.mjs tests/e2e/harness/preview.ts --bundle-demo",
    "preview:bundle:run": "node --import ./tests/fixtures/engine/ts-resolve-register.mjs tests/e2e/harness/preview.ts --bundle-demo"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.4",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  },
  "dependencies": {
    "next": "16.4.2",
    "pretendard": "1.3.9",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
